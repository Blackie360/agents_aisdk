# Copy to .env.local for local development. Never commit real values.
# Set production values in the Vercel project settings (server-only, no NEXT_PUBLIC_ prefix).

# Neon Postgres (pooled connection string). Holds usage events and the shared
# rate-limit counters. Apply migrations/001_usage.sql and migrations/002_rate_limits.sql.
# In production, server-key explanations and /admin fail closed without it.
DATABASE_URL=

# Better Auth (Google/GitHub sign-in). Sign-in is disabled unless the secret,
# DATABASE_URL, one provider pair and (in production) BETTER_AUTH_URL are set.
# Apply migrations/003_better_auth.sql first.
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin, no trailing slash, e.g. https://schema.blackielabs.com
BETTER_AUTH_URL=
# Callback URLs: $BETTER_AUTH_URL/api/auth/callback/google and .../github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated admin emails; must match the provider-verified account email.
ADMIN_EMAILS=

# Free server-key explanations for signed-out visitors (per hashed IP).
ANON_TRIAL_LIMIT=3
ANON_TRIAL_WINDOW_DAYS=30

# Optional shared server key. Keyless requests always use SERVER_AI_PROVIDER and
# its model env var; clients cannot choose the provider or model the server pays for.
SERVER_AI_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=
# Other providers (server key only used if SERVER_AI_PROVIDER names them):
# GEMINI_API_KEY= GEMINI_MODEL= OPENAI_API_KEY= OPENAI_MODEL=
# MOONSHOT_API_KEY= KIMI_MODEL= ANTHROPIC_API_KEY= ANTHROPIC_MODEL=

# Secret key for hashing client IPs in the rate-limit store (HMAC-SHA-256).
# Required in production: without it, server-key explanations return 503 and
# /admin is refused. Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=

# Rate limits (shared store). Defaults shown.
RATE_LIMIT_EXPLAIN_PER_MINUTE=5
SERVER_KEY_DAILY_PER_IP=20
SERVER_KEY_DAILY_GLOBAL=300
RATE_LIMIT_ADMIN_PER_MINUTE=5
RATE_LIMIT_ADMIN_DAILY_PER_IP=50
